# 운영 환경. 이 파일을 .env.prod 로 복사하고 값을 채운 뒤 `make gen` 을 돌린다.
#   cp .env.prod.example .env.prod
#
# **여기 값으로 실제 매입내역이 올라간다.** Sheets 는 append-only 라
# 잘못 들어간 행은 앱으로 못 지운다 — 확인은 개발 환경(.env.dev)에서 한다.
#
# 시트·드라이브는 **새로 만들어** 여기 넣는다. 원래 쓰던 것들은
# 개발(.env.dev)이 물려받았다.
#
# **Slack 은 여기도 새 앱이다.** 원래 쓰던 앱은 이름이 `bodit-purchase-test` 라
# 운영 채널에 `-test` 가 붙은 봇이 글을 올렸는데, 그 이름을 고칠 방법이 없다 —
# 봇 유저는 **최초 설치 때 한 번** 만들어지고, Display Name 을 바꿔 재설치해도
# 기존 봇 유저는 개명되지 않는다. 그래서 이름을 제대로 단 앱을 새로 만들어
# 갈아탔다. 다만 **개발(.env.dev)에서 한 번 돌려본 뒤** 여기 넣는다 —
# 한 번도 안 써본 앱이 실제 제출을 받는 쪽이 더 나쁘다.
#
# 아직 안 만든 값은 자리값(REPLACE_ME)을 그대로 둔다 — 개발 빌드는 그대로
# 돌아가고, `make *-prod` 가 자리값이 남아 있으면 빌드를 거부한다.
#
# 주의: envied 는 난독화일 뿐 보안이 아니다. 런타임에는 평문으로 나간다.
#   Anthropic 은 콘솔 지출 한도, Slack 은 좁은 scope 가 실질 방어선이다.
#   Slack scope 는 chat:write, files:write, files:read 셋뿐이다.
#   scope 를 바꾸면 앱을 워크스페이스에 재설치해야 새 토큰이 나온다.

ANTHROPIC_API_KEY=REPLACE_ME
# 운영용으로 만든 Slack 앱의 봇 토큰 — 이름에 `-test` 가 안 붙은 쪽이다.
# 그 봇이 실사용 채널에 들어가 있어야 한다.
SLACK_BOT_TOKEN=REPLACE_ME
# 실사용 채널.
SLACK_CHANNEL_ID=REPLACE_ME
# 이메일 → Slack user id. `email:ID` 를 쉼표로 잇는다.
#   예: a@bodit.co:U0AAA,b@bodit.co:U0BBB
# 왜 여기 두나: 이 레포는 공개돼 있어 코드에 박으면 사내 전원의 이메일과
# Slack ID 명단이 그대로 공개된다.
#
# **여기는 바닥일 뿐이다.** 최신 명단은 Remote Config 의 `slack_user_ids` 에
# 있고 그쪽이 이긴다 — 입사자는 콘솔에 적는다. 이 줄을 고치면 `make gen` +
# 재배포가 필요하다. 그래도 비워두지 않는 이유: FIREBASE_* 를 비운 빌드에서도
# 멘션이 붙어야 한다.
SLACK_USER_IDS=
# 새 매입내역 시트. **과거 이력을 같이 옮겨야 한다** — 비목 추천이 과거 행을
# 읽어서 나오므로, 빈 시트로 시작하면 추천이 한동안 뜨지 않는다.
# 수식 컬럼(해당년도·해당월·분류명)과 _비목마스터·_분류마스터 탭도 같이.
SPREADSHEET_ID=REPLACE_ME
# 카드보유내역. 운영팀이 관리하는 그 파일 — 개발과 같은 ID 다.
CARD_SHEET_ID=REPLACE_ME
# 새 증빙 폴더.
DRIVE_FOLDER_ID=REPLACE_ME
# 번들 ID `co.bodit.boditApp` 로 만든 iOS 유형 OAuth 클라이언트.
# 지금 스토어에 올라간 앱이 쓰는 그것 — 바꾸지 않는다.
GOOGLE_IOS_CLIENT_ID=REPLACE_ME
# "웹 애플리케이션" 유형. Android 가 Credential Manager 에 넘긴다.
GOOGLE_SERVER_CLIENT_ID=REPLACE_ME

# ── Firebase (Remote Config 전용) ─────────────────────────────────────
#
# 용도는 하나다 — 새 버전이 올라왔는지 묻는 것. 여기 값이 비면 운영 빌드에서
# 업데이트 안내가 안 뜬다(앱은 그대로 돈다. 자리값 검사도 안 걸린다).
#
# **지금 스토어·Firebase 에 등록된 그 앱** 값이다 — 번들 ID
# co.bodit.boditApp · 패키지명 co.bodit.bodit_app. 바꾸지 않는다.
#
# 값을 어디서 보나: 콘솔 → 프로젝트 설정 → 내 앱 → (운영 앱)
#   GoogleService-Info.plist  →  API_KEY · GOOGLE_APP_ID
#   google-services.json      →  current_key · mobilesdk_app_id
# 앱 ID 는 앱마다 다르고, **API 키는 플랫폼 단위**라 개발·운영이 같은 값이다.
FIREBASE_PROJECT_ID=
FIREBASE_PROJECT_NUMBER=
FIREBASE_API_KEY_IOS=
FIREBASE_APP_ID_IOS=
FIREBASE_API_KEY_ANDROID=
FIREBASE_APP_ID_ANDROID=
