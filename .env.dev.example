# 개발 환경. 이 파일을 .env.dev 로 복사하고 값을 채운 뒤 `make gen` 을 돌린다.
#   cp .env.dev.example .env.dev
#
# **개발이 원래 쓰던 시트·드라이브를 물려받았다.** 운영을 새로 만들면서
# 자리를 바꿨다 — 그래서 그 두 값은 예전 .env 그대로다.
#
# **Slack 은 둘 다 새 앱이다.** 원래 앱은 이름이 `bodit-purchase-test` 로 굳어
# 있는데 고칠 방법이 없다 — 봇 유저는 **최초 설치 때 한 번** 만들어지고, 앱
# 설정의 Display Name 을 바꿔 재설치해도 이미 있는 봇 유저는 개명되지 않는다
# (저장·재설치 둘 다 해봤지만 Real Name 이 그대로였다). 그래서 운영도 이름을
# 제대로 단 앱을 새로 만들어 갈아탔다.
#
# 개발 빌드는 배포하지 않는다. 내 기기에서 debug 로만 돈다.
#
# 주의: envied 는 난독화일 뿐 보안이 아니다. 런타임에는 평문으로 나간다.
#   Anthropic 은 콘솔 지출 한도, Slack 은 좁은 scope 가 실질 방어선이다.
#   Slack scope 는 chat:write, files:write, files:read 셋뿐이다.
#   scope 를 바꾸면 앱을 워크스페이스에 재설치해야 새 토큰이 나온다.

# 운영과 같은 키를 써도 동작한다. 다른 키로 두면 콘솔에서 지출이 갈려 보인다.
ANTHROPIC_API_KEY=
# 개발용으로 만든 Slack 앱의 봇 토큰.
# scope 는 chat:write, files:write, files:read 셋만 주고 워크스페이스에 설치한다.
SLACK_BOT_TOKEN=
# 테스트 채널. 봇이 그 채널에 들어가 있어야 한다.
SLACK_CHANNEL_ID=
# 이메일 → Slack user id. `email:ID` 를 쉼표로 잇는다.
#   예: a@bodit.co:U0AAA,b@bodit.co:U0BBB
# user id 는 워크스페이스 단위라 Slack 앱이 달라도 운영과 같은 값을 쓴다.
SLACK_USER_IDS=
# 원래 쓰던 매입내역 시트. 과거 이력이 여기 쌓여 있다.
SPREADSHEET_ID=
# 카드보유내역. 앱이 읽기만 하므로 운영과 **같은 ID** 를 넣는다.
CARD_SHEET_ID=
# 원래 쓰던 증빙 폴더.
DRIVE_FOLDER_ID=
# 번들 ID `co.bodit.boditApp.dev` 로 만든 iOS 유형 OAuth 클라이언트.
# **운영 것을 그대로 쓸 수 없다** — 구글 클라이언트는 번들 ID 로 매칭되는데
# 개발 빌드는 `.dev` 가 붙은 번들로 깔리기 때문이다. 배포 여부와 무관하다.
# 뒤집은 값을 ios/Flutter/Dev.xcconfig 의 GOOGLE_REVERSED_CLIENT_ID 에도 넣는다.
GOOGLE_IOS_CLIENT_ID=
# "웹 애플리케이션" 유형. 패키지명과 무관해서 운영과 같은 값을 쓴다.
# 단 GCP 에 Android 클라이언트(co.bodit.bodit_app.dev + SHA-1)를 따로 등록해야
# 개발 빌드에서 Android 로그인이 통과한다. iOS 만 쓸 거면 필요 없다.
GOOGLE_SERVER_CLIENT_ID=

# ── Firebase (Remote Config 전용) ─────────────────────────────────────
#
# 용도는 하나다 — 새 버전이 올라왔는지 묻는 것. 비워두면 업데이트 안내만
# 안 뜨고 앱은 그대로 돈다(`make *-prod` 도 막지 않는다).
#
# **개발은 Firebase 에 따로 등록된 앱이다.** 번들 ID·패키지명이 `.dev` 로
# 갈리므로 운영 앱 값을 그대로 쓰면 Firebase Installations 가 거절한다 —
# 구글 OAuth 클라이언트가 번들 ID 로 매칭되는 것과 같은 이유다.
#
# 값을 어디서 보나: 콘솔 → 프로젝트 설정 → 내 앱 → (개발 앱)
#   GoogleService-Info.plist  →  API_KEY · GOOGLE_APP_ID
#   google-services.json      →  current_key · mobilesdk_app_id
# 파일을 받아 레포에 넣지는 않는다(.gitignore).
# 앱 ID 는 앱마다 다르고, **API 키는 플랫폼 단위**라 개발·운영이 같은 값이다.
FIREBASE_PROJECT_ID=
FIREBASE_PROJECT_NUMBER=
FIREBASE_API_KEY_IOS=
FIREBASE_APP_ID_IOS=
FIREBASE_API_KEY_ANDROID=
FIREBASE_APP_ID_ANDROID=
