# 개발 환경. 이 파일을 .env.dev 로 복사하고 값을 채운 뒤 `make gen` 을 돌린다.
#   cp .env.dev.example .env.dev
#
# 운영과 **다른 시트·폴더·Slack 앱**을 가리켜야 한다. 같은 곳을 가리키면
# 환경을 나눈 의미가 없다 — Sheets 는 append-only 라 테스트로 들어간 행을
# 앱으로 지울 수 없다.
#
# 주의: envied 는 난독화일 뿐 보안이 아니다. 런타임에는 평문으로 나간다.
#   Anthropic 은 콘솔 지출 한도, Slack 은 좁은 scope 가 실질 방어선이다.
#   Slack scope 는 chat:write, files:write, files:read 셋뿐이다.
#   scope 를 바꾸면 앱을 워크스페이스에 재설치해야 새 토큰이 나온다.

# 운영과 같은 키를 써도 동작하지만, 다른 키로 두면 콘솔에서 지출이 갈려 보인다.
ANTHROPIC_API_KEY=
# 개발용으로 **새로 만든 Slack 앱**의 봇 토큰. 운영 앱 토큰을 넣지 않는다 —
# 채널 ID 한 글자 실수로 운영 채널에 글이 간다.
SLACK_BOT_TOKEN=
# 개발용 채널(예: #purchase-dev). 그 채널에 봇을 초대해야 한다.
SLACK_CHANNEL_ID=
# 이메일 → Slack user id. `email:ID` 를 쉼표로 잇는다.
#   예: a@bodit.co:U0AAA,b@bodit.co:U0BBB
# user id 는 워크스페이스 단위라 운영과 같은 값을 넣으면 된다.
SLACK_USER_IDS=
# 운영 매입내역 시트의 **사본**. 수식 컬럼과 _비목마스터·_분류마스터 탭이
# 같이 복사돼야 한다.
SPREADSHEET_ID=
# 카드보유내역. 앱이 읽기만 하므로 운영과 **같은 ID** 를 넣는다.
CARD_SHEET_ID=
# 개발용 증빙 폴더. 운영 폴더와 섞이면 회계 담당자가 테스트 파일을 보게 된다.
DRIVE_FOLDER_ID=
# 번들 ID `co.bodit.boditApp.dev` 로 만든 iOS 유형 OAuth 클라이언트.
# 뒤집은 값을 ios/Flavor.xcconfig 의 GOOGLE_REVERSED_CLIENT_ID 에도 넣어야 한다.
GOOGLE_IOS_CLIENT_ID=
# "웹 애플리케이션" 유형. 패키지명과 무관해서 운영과 같은 값을 쓴다.
# 단 GCP 에 Android 클라이언트(co.bodit.bodit_app.dev + SHA-1)를 따로 등록해야
# 개발 빌드에서 로그인이 통과한다.
GOOGLE_SERVER_CLIENT_ID=
