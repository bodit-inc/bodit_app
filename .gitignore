# Flutter / Dart
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock

# IDE
.idea/
# .vscode 는 통째로 무시하되 settings.json 은 공유한다 —
# fvm SDK 경로가 여기 있어서 없으면 다른 사람이 열었을 때 전부 빨개진다.
.vscode/*
!.vscode/settings.json
*.iml
*.iws

# macOS
.DS_Store

# 로컬 비밀 — 절대 커밋 금지 (§ CLAUDE.md 보안)
.env
.env.*
**/secrets.dart
**/google-services.json
**/GoogleService-Info.plist
*.jks
*.keystore

# Kotlin 컴파일러 부산물 — 빌드할 때마다 새로 생긴다
android/.kotlin/

# 빌드 산출물
*.apk
*.aab
*.ipa

# fvm — .fvmrc(버전 핀)는 커밋하고 SDK 심볼릭 링크는 무시한다
.fvm/
!.fvmrc

# build_runner 생성물 — 커밋하지 않는다. 받은 뒤 아래를 한 번 돌린다:
#   fvm dart run build_runner build --delete-conflicting-outputs
*.g.dart
*.freezed.dart
*.drift.dart
