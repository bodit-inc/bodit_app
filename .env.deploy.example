# 배포에만 쓰는 값.
#
# `.env.dev`·`.env.prod` 와 **섞지 않는다** — 저쪽은 envied 가 앱 바이너리에
# 굽는 값이라, 업로드 키를 거기 적으면 전 직원 기기에 App Store Connect 키가
# 들어간다. 이 파일은 스크립트(`tool/deploy.sh`)만 읽는다.
#
#   cp .env.deploy.example .env.deploy
#
# 값을 채운 `.env.deploy` 는 커밋하지 않는다(.gitignore 의 `.env.*`).

# --- Android: Firebase App Distribution -----------------------------------
#
# 테스터 그룹의 **alias** 다. 화면에 보이는 이름이 아니다 — 콘솔에서 그룹을
# 열면 주소 끝에 붙어 있다(…/testers?group=<여기>). 틀리면 업로드는 되고
# 배포만 안 되므로, 처음 한 번은 콘솔에서 눈으로 확인한다.
APPDIST_GROUP=bodit

# --- iOS: App Store Connect API -------------------------------------------
#
# App Store Connect → 사용자 및 액세스 → 통합 → App Store Connect API 에서
# 키를 만든다(역할은 App Manager 면 된다). **.p8 파일은 만들 때 한 번만**
# 내려받을 수 있다 — 잃으면 키를 다시 만들어야 한다.
#
# 왜 Apple ID + 앱 암호가 아닌가: 2단계 인증에 안 걸리고, TestFlight 의
# What to Test 를 쓰는 API 가 같은 키로 열린다(`tool/testflight_notes.py`).
ASC_KEY_ID=
ASC_ISSUER_ID=

# 비워두면 ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8 를 본다.
# altool 이 그 디렉토리를 이름으로 뒤지기 때문에, 그 자리에 두면 편하다.
ASC_KEY_FILE=

# What to Test 를 어느 언어 칸에 넣을지. 사내 배포라 ko 로 둔다.
TESTFLIGHT_LOCALE=ko
