<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Bodit App</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>bodit_app</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<!-- ── Google 로그인 OAuth 콜백 ──────────────────────────────────
	     Dart 에서 clientId 를 넘기므로 GIDClientID 키는 필요 없다.
	     그런데 이 URL scheme 은 **생략할 수 없다** — 구글이 로그인 후
	     앱으로 되돌아오는 통로다.

	     값은 iOS 클라이언트 ID 를 '뒤집은' 것이다:
	       123456-abc.apps.googleusercontent.com
	       → com.googleusercontent.apps.123456-abc

	     TODO(james): 아래 REPLACE_ME 를 실제 값으로 바꿀 것.
	     GCP 콘솔 → OAuth 클라이언트(iOS, 번들 ID co.bodit.boditApp) 에서 받는다.
	──────────────────────────────────────────────────────────── -->
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>com.googleusercontent.apps.768953981137-9b2dmd95dbg8bru00qf06d3th7k38ui9</string>
				</array>
			</dict>
		</array>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<!-- ── 수출 규정(암호화) ────────────────────────────────────────
	     이 키가 없으면 **업로드할 때마다** App Store Connect 가
	     "암호화를 쓰는가" 를 묻고, 답하기 전까지 빌드가 테스터에게 안 간다.

	     false 로 둘 수 있는 근거: 앱이 쓰는 암호화는 HTTPS 와
	     flutter_secure_storage 의 키체인뿐이다. 둘 다 OS 가 제공하는
	     표준 암호화라 '비면제(non-exempt)' 에 해당하지 않는다.
	     독자 암호 구현을 넣는 날에는 이 값을 다시 따져야 한다.
	──────────────────────────────────────────────────────────── -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<!-- ── 권한 설명 문구 ──────────────────────────────────────────
	     **생략하면 앱이 거부당하는 게 아니라 그 자리에서 죽는다.**
	     iOS 는 설명 문구 없는 권한 요청을 거부가 아니라 프로세스 종료로
	     처리한다. 그리고 TestFlight 내부 배포(심사 없음)라도 업로드 단계의
	     자동 검증에서 ITMS-90683 으로 먼저 막힌다.

	     문구는 **구체적으로** 쓴다 — "카메라가 필요합니다" 같은 동어반복은
	     Apple 이 반려 사유로 든다. 무엇에 쓰는지를 적는다.

	     여기 두 개뿐인 이유:
	       - 카메라   `ImagePicker().pickImage(source: camera)` (capture_service.dart)
	       - 사진앨범 `ImagePicker().pickMultiImage()` (같은 파일)
	       - 마이크   없음 — 동영상을 찍지 않는다
	       - 앨범쓰기 없음 — 증빙을 앱 디렉토리로 복사만 하고 앨범에 저장하지 않는다
	       - PDF 선택 file_picker 는 문서 피커(Files 앱)라 권한이 필요 없다
	──────────────────────────────────────────────────────────── -->
		<key>NSCameraUsageDescription</key>
		<string>영수증·이체확인증 같은 증빙을 촬영해 매입내역에 첨부합니다.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>앨범에 저장해 둔 증빙 사진을 골라 매입내역에 첨부합니다.</string>
		<key>UIApplicationSceneManifest</key>
		<dict>
			<key>UIApplicationSupportsMultipleScenes</key>
			<false/>
			<key>UISceneConfigurations</key>
			<dict>
				<key>UIWindowSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneClassName</key>
						<string>UIWindowScene</string>
						<key>UISceneConfigurationName</key>
						<string>flutter</string>
						<key>UISceneDelegateClassName</key>
						<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
						<key>UISceneStoryboardFile</key>
						<string>Main</string>
					</dict>
				</array>
			</dict>
		</dict>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UIStatusBarHidden</key>
		<false/>
	</dict>
</plist>
